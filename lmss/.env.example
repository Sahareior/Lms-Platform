# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upstash Redis (caching + rate limiting) ──────────────────
# Create a free database at https://console.upstash.com and copy the REST API credentials.
UPSTASH_REDIS_REST_URL="https://rested-mastiff-183693.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAs2NAAIgcDJiMDIwZDRmMjc1N2I0ODg4YTUxZDkwYzU3OGY4YmVkMA"

# ─── Security ─────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. When empty, local dev
# origins (http://localhost:5173 etc.) are allowed.
CORS_ORIGINS=https://your-web-app.vercel.app

# ─── Resend (transactional email: password reset) ─────────────
# Create an API key at https://resend.com/api-keys. Without a key, emails are
# logged to the console instead of sent (dev fallback).
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Geneseon LMS <onboarding@resend.dev>"

# URL of the frontend app (used to build password-reset links).
FRONTEND_URL=https://your-web-app.vercel.app