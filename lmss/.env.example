# ─── Server ─────────────────────────────────────────────────
PORT=3000

# ─── Database ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>

# ─── Auth ───────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upstash Redis (caching + rate limiting) ──────────────────
# Create a free database at https://console.upstash.com and copy the REST API credentials.
UPSTASH_REDIS_REST_URL="https://rested-mastiff-183693.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAs2NAAIgcDJiMDIwZDRmMjc1N2I0ODg4YTUxZDkwYzU3OGY4YmVkMA"