{
  "name": "my-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "description": "Monorepo for app and website",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native-web": "^0.21.2",
    "sweetalert2": "^11.26.25",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "react-native": "0.81.5"
  }
}
